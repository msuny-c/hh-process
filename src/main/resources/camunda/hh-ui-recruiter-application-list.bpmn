<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_hh_ui_recruiter_application_list" targetNamespace="http://itmo.ru/hhprocess/camunda" exporter="Camunda Modeler" exporterVersion="5.48.0">
  <bpmn:collaboration id="Collaboration_hhUiRecruiterApplicationList" name="Отклики рекрутера">
    <bpmn:participant id="Participant_hhUiRecruiterApplicationList" name="Отклики рекрутера" processRef="hhUiRecruiterApplicationList" />
  </bpmn:collaboration>
  <bpmn:process id="hhUiRecruiterApplicationList" name="Отклики рекрутера" isExecutable="true" camunda:candidateStarterGroups="RECRUITER" camunda:historyTimeToLive="30">
    <bpmn:laneSet id="LaneSet_hhUiRecruiterApplicationList">
      <bpmn:lane id="Lane_hhUiRecruiterApplicationList_RoleSystem" name="Рекрутер / администратор / система">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>LoadRecruiterApplicationList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DisplayRecruiterApplicationList</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" camunda:initiator="starterUserId" />
    <bpmn:serviceTask id="LoadRecruiterApplicationList" name="Загрузить отклики по вакансиям текущего рекрутера" camunda:type="external" camunda:topic="ui-query" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="LoadRecruiterApplicationList" />
    <bpmn:sequenceFlow id="F2" sourceRef="LoadRecruiterApplicationList" targetRef="DisplayRecruiterApplicationList" />
    <bpmn:sequenceFlow id="F3" sourceRef="DisplayRecruiterApplicationList" targetRef="End" />
    <bpmn:userTask id="DisplayRecruiterApplicationList" name="Показать рекрутеру отклики по его вакансиям" camunda:formRef="ui-json-display-form" camunda:formRefBinding="latest" camunda:assignee="${starterUserId}" />
    <bpmn:endEvent id="End" name="Список откликов показан рекрутеру" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_hhUiRecruiterApplicationList">
    <bpmndi:BPMNPlane id="BPMNPlane_hhUiRecruiterApplicationList" bpmnElement="Collaboration_hhUiRecruiterApplicationList">
      <bpmndi:BPMNShape id="BPMNShape_Participant_hhUiRecruiterApplicationList" bpmnElement="Participant_hhUiRecruiterApplicationList" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="860" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Lane_hhUiRecruiterApplicationList_RoleSystem" bpmnElement="Lane_hhUiRecruiterApplicationList_RoleSystem" isHorizontal="true">
        <dc:Bounds x="260" y="100" width="740" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Start" bpmnElement="Start">
        <dc:Bounds x="300" y="162" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_LoadRecruiterApplicationList" bpmnElement="LoadRecruiterApplicationList">
        <dc:Bounds x="405" y="140" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_DisplayRecruiterApplicationList" bpmnElement="DisplayRecruiterApplicationList">
        <dc:Bounds x="635" y="140" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_End" bpmnElement="End">
        <dc:Bounds x="872" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="848" y="198" width="85" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_F1" bpmnElement="F1">
        <di:waypoint x="336" y="180" />
        <di:waypoint x="405" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_F2" bpmnElement="F2">
        <di:waypoint x="575" y="180" />
        <di:waypoint x="635" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_F3" bpmnElement="F3">
        <di:waypoint x="805" y="180" />
        <di:waypoint x="872" y="180" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
